# Secrets — never committed, per the non-negotiable secrets rule
.env
.env.*
*.key
*.pem
# #467: the install token file (python3 -m core.manage.mcp_token generate secrets/constructicon_token)
secrets/

# Python
venv/
__pycache__/
*.pyc

# Runtime data — user uploads and the SQLite index are data, not code
storage/
imagerepo.db
imagerepo.db-journal

# Site exports — generated builds, not source code
exports/

# #698: scripts/deploy.sh's db/ copies on a host without ZFS (<instance>/predeploy-backups/)
predeploy-backups/

# The type sampler's output (#720, scripts/make_type_samples.py): generated, and it holds the
# executable-class samples (PE, installers) that must never be committed (Windows Defender rule)
samples-out/

# Logs
*.log

# Synced/generated artifacts
hudu_clients.json

# OS
.DS_Store

# Claude Code agent worktree scratch space — created per background agent,
# cleaned up after merge; never meant to be tracked
.claude/worktrees/

# Build version written by scripts/deploy.sh (#508)
core/VERSION.json
