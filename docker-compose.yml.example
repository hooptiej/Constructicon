services:
  # #688: the app code is BAKED INTO THE IMAGE. No service here bind-mounts core/, web/,
  # mcp_server/ or assets/: prod runs exactly the image scripts/deploy.sh built and tagged with the
  # release version (constructicon:<version>, plus constructicon:latest as the moving tag that
  # these services name). Rollback = `./scripts/deploy.sh --rollback <previous version>`.
  # Test/dev installs that want "copy files in, restart, no rebuild" add the code mounts back with
  # docker-compose.override.yml (copy docker-compose.override.yml.example; compose loads it on its
  # own), which also switches deploy.sh to its mount-and-restart mode.
  #
  # #453: mount the DB's DIRECTORY, never the bare imagerepo.db file. SQLite runs in
  # WAL mode, which keeps -wal/-shm next to the DB; with a file-only mount each
  # container gets private copies and web + mcp corrupt the shared database.
  #
  # #643: the app image runs as a non-root user, UID/GID 1000 (Dockerfile ARG APP_UID /
  # APP_GID). Every host directory bind-mounted read-write below (storage, db, backups,
  # exports, import) must be owned by that UID, e.g. `sudo chown -R 1000:1000 ./storage ./db`.
  # #699: if one isn't, web and MCP refuse to start and say which folder, its owner and the fix
  # (README.md, "Install on a new host", step 3).
  #
  # #652: and private to it. Target: data directories 0750, their files 0640, backup zips 0600
  # (`sudo chmod 0750 ./storage ./db ./backups ./exports` on a fresh install). The app keeps new
  # files that way itself (umask 027, set at startup; CONSTRUCTICON_UMASK overrides it, octal). For
  # an existing install: `bash ops/fix-data-permissions.sh <data root>` (dry run; add --apply).
  # Anything that reads these directories as another user (a guest SMB share) loses access.
  # The web container NEVER mounts /var/run/docker.sock: Ollama's caption safety-valve
  # restart goes through the ollama-restarter sidecar below.
  #
  # #634: no service mounts ./scripts. The always-on containers hold app code only (core, web,
  # mcp_server, assets). The two operational tools live in core/manage/ and run in place:
  #   sudo docker exec -it constructicon-web python3 -m core.manage.reset_password <username>
  #   sudo docker exec constructicon-web python3 -m core.manage.mcp_token check --web-url http://localhost:8000
  # A maintenance script from scripts/ runs from the host in a one-off twin of the web container
  # that mounts ./scripts read-only for that run only (see CLAUDE.md "Scripts: what runs where"):
  #   ./scripts/run_tool.sh constructicon-web scripts/<tool>.py ...
  constructicon-web:
    build: .
    image: constructicon:latest   # #688: deploy.sh also tags each build constructicon:<version>
    container_name: constructicon-web
    ports:
      - "8000:8000"
    networks:
      - default
      - restart-valve      # #643: reach ollama-restarter, and nothing else on that network
      - captions           # #687: reach the ollama sidecar at http://ollama:11434
    volumes:
      - ./storage:/app/storage
      - ./db:/app/data
      # #467 step 2: the install token, ONE file shared with the MCP service below. Create it with
      #   python3 -m core.manage.mcp_token generate ./secrets/constructicon_token   (mode 600)
      # #648: it is also what claims a fresh install: /setup asks for it before it creates the
      #   first admin, so create it BEFORE the first `up` (and before the site is reachable).
      - ./secrets/constructicon_token:/run/secrets/constructicon_token:ro
      # #643: the restart sidecar's shared secret (same file as ollama-restarter's).
      - ./secrets/ollama_restart_token:/run/secrets/ollama_restart_token:ro
    environment:
      - IMAGEREPO_BASE_URL=http://10.0.1.78:8000
      - CONSTRUCTICON_DB_PATH=/app/data/imagerepo.db
      # Non-browser clients (scripts) send it as Authorization: Bearer.
      - CONSTRUCTICON_INSTALL_TOKEN_FILE=/run/secrets/constructicon_token
      # #645: browser security headers (web/security_headers.py) are always on; these only tune them.
      #   HSTS, sent ONLY on requests that really arrived over HTTPS. Off by default (plain-HTTP
      #   installs must never send it). Set it once the install is served over HTTPS (behind a
      #   proxy, that also needs CONSTRUCTICON_TRUSTED_PROXIES below), e.g. one year:
      # - CONSTRUCTICON_HSTS_SECONDS=31536000
      # #646: behind a TLS reverse proxy (Caddy, nginx; see the commented `proxy` service at the
      # bottom and CLAUDE.md "Behind a reverse proxy"), list the proxy's address(es) as the app
      # sees them: IPs and/or CIDRs, comma-separated. Only requests whose TCP peer is in this list
      # may set the scheme (X-Forwarded-Proto) and client address (X-Forwarded-For): that gives the
      # session cookie its Secure flag, HSTS, the https same-origin check and a per-client sign-in
      # limiter. Unset (the default, and the home install) = forwarded headers are ignored.
      # Never list a network that untrusted clients can connect from directly.
      # - CONSTRUCTICON_TRUSTED_PROXIES=172.30.0.10
      #   Replace the app pages' Content-Security-Policy (default: security_headers.APP_CSP), or "off".
      #   Keep 'nonce-{nonce}' in its script-src ({nonce} is filled per request), or inline scripts stop.
      # - CONSTRUCTICON_CSP=
      #   Diagnose a page the CSP breaks: send it as Content-Security-Policy-Report-Only instead.
      # - CONSTRUCTICON_CSP_REPORT_ONLY=1
      #   #724 d: a web link's OCR fetches its page's title and summary through core/safe_fetch.py
      #   (public addresses only, 2 MB / 10 s, one fetch at a time). "off" for an offline install:
      #   links then settle grey "page fetching is turned off on this install".
      # - CONSTRUCTICON_LINK_FETCH=off
      #   Seconds between page fetches (default 2), so a backfill of many links never bursts a site.
      # - CONSTRUCTICON_LINK_FETCH_DELAY_SECONDS=2
      #   #724 e: a YouTube video's OCR (and a background pass for the backlog and retries) asks
      #   YouTube for its captions through youtube-transcript-api (an unofficial endpoint), with a
      #   hard 20 s deadline, one fetch at a time (the delay above), noise like [Music] removed.
      #   On by default; "off" for an offline install (stored transcripts stay searchable). Set it
      #   on the MCP service too if MCP uploads should skip it.
      # - CONSTRUCTICON_TRANSCRIPTS=off
      # #687: captions come from the `ollama` sidecar below (compose profile `captions`).
      # The model is ONE value for the app and the sidecar's first-start pull: set
      # CAPTION_OLLAMA_MODEL in .env (default moondream). An install that runs without the
      # profile should set CAPTION_DISABLED=1, so uploads skip captions instead of failing
      # each one against a missing Ollama.
      - CAPTION_OLLAMA_URL=http://ollama:11434
      - CAPTION_OLLAMA_MODEL=${CAPTION_OLLAMA_MODEL:-moondream}
      # - CAPTION_DISABLED=1
      # #643: captions' safety valve. Leave both unset (and drop the sidecar) for an
      # install without Ollama: captions then just have no restart valve.
      - CAPTION_RESTART_URL=http://ollama-restarter:8080/restart
      - CAPTION_RESTART_TOKEN_FILE=/run/secrets/ollama_restart_token
      # #649: request-body caps (web/body_limit.py), checked before anything reads the body; over
      # the cap = 413 payload_too_large. The defaults are shown; uncomment to change one.
      #   Uploads (/api/upload, /api/image/<slug>/replace-file): the upload cap + 1 MB of form framing.
      # - CONSTRUCTICON_MAX_UPLOAD_MB=25
      #   Sign-in, setup, my password, Admin > Users (/api/auth/*, /api/account/*, /api/users*).
      # - CONSTRUCTICON_MAX_AUTH_BODY_KB=64
      #   Every other route (JSON and form bodies).
      # - CONSTRUCTICON_MAX_BODY_KB=1024
    # #646: --no-proxy-headers turns off uvicorn's own forwarded-header handling (on by default for
    # 127.0.0.1), so CONSTRUCTICON_TRUSTED_PROXIES (web/proxy_trust.py) is the only place they're read.
    command: uvicorn web.app:app --host 0.0.0.0 --port 8000 --no-proxy-headers

  # #643: the ONLY container with the Docker socket. It does one thing: restart the
  # container named in RESTARTER_CONTAINER (never taken from the request), at most once
  # per RESTARTER_MIN_INTERVAL_SECONDS, for a caller that presents the shared secret.
  # No published port; its only network is `internal`, shared with the web service.
  # Create the secret once:
  #   python3 -m core.manage.mcp_token generate ./secrets/ollama_restart_token   (mode 600)
  # It runs as UID 1000 (so it can read that file) plus the group that owns the socket:
  # set group_add to `stat -c %g /var/run/docker.sock` on your host (999 on the NAS).
  # #687: in the `captions` profile with Ollama itself, so an install without captions runs
  # no container holding the Docker socket (web treats the missing sidecar as "no valve").
  ollama-restarter:
    build: ./ops/ollama-restarter
    container_name: constructicon-ollama-restarter
    profiles: ["captions"]
    user: "1000:1000"
    group_add:
      - "999"
    networks:
      - restart-valve
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./secrets/ollama_restart_token:/run/secrets/ollama_restart_token:ro
    environment:
      - RESTARTER_CONTAINER=ollama
      - RESTARTER_TOKEN_FILE=/run/secrets/ollama_restart_token
      - RESTARTER_MIN_INTERVAL_SECONDS=300
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped

  # #687: the caption model server, owned by this compose instead of a hand-made project.
  # Optional: it runs only with the `captions` profile, e.g.
  #   docker compose --profile captions up -d          (or COMPOSE_PROFILES=captions in .env)
  # Without it the app runs as before with captions off (set CAPTION_DISABLED=1 on web).
  # - Pinned: version tag AND digest (the multi-arch index digest, as `docker buildx imagetools
  #   inspect ollama/ollama:<tag>` prints it). To bump: pick a release, read that digest, change
  #   both halves together, and live-test captions on constructicon-test before prod.
  # - Not exposed: no published port. Its only networks are `captions` (internal: web and the
  #   test instance reach it as http://ollama:11434) and `ollama-egress` (its own, used only to
  #   pull models). For direct testing use `docker exec ollama ollama list`, or uncomment ports:
  #   bound to 127.0.0.1, never to the LAN.
  # - GPU: CPU works (slowly). For NVIDIA, add the override file docker-compose.gpu.yml:
  #   docker compose -f docker-compose.yml -f docker-compose.gpu.yml --profile captions up -d
  #   (or COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml in .env). Run ONE Ollama per GPU:
  #   a second install on the same box (a test instance) should share this one, not start its own.
  # - First start pulls CAPTION_OLLAMA_MODEL if it isn't on the volume (ops/ollama/serve-and-pull.sh;
  #   idempotent, a restart doesn't re-pull). Models live in OLLAMA_DATA_DIR (default ./ollama-data;
  #   point it at an existing model directory to reuse it without re-downloading).
  # - container_name stays `ollama`: the restart sidecar's RESTARTER_CONTAINER names it.
  ollama:
    image: ollama/ollama:0.35.1@sha256:292ee7945dfc3d5840a181f3ab86fedb1e66703e02c8af98b50f4da56b7e278c
    container_name: ollama
    profiles: ["captions"]
    entrypoint: ["/bin/sh", "/opt/constructicon/serve-and-pull.sh"]
    networks:
      - captions
      - ollama-egress
    volumes:
      - ${OLLAMA_DATA_DIR:-./ollama-data}:/root/.ollama
      - ./ops/ollama/serve-and-pull.sh:/opt/constructicon/serve-and-pull.sh:ro
    environment:
      - CAPTION_OLLAMA_MODEL=${CAPTION_OLLAMA_MODEL:-moondream}
    # ports:
    #   - "127.0.0.1:11434:11434"   # opt-in, for direct testing from the host only
    restart: unless-stopped

  constructicon-mcp:
    image: constructicon:latest   # #688: the same image as the web service (it builds it)
    container_name: constructicon-mcp
    volumes:
      - ./storage:/app/storage
      - ./db:/app/data
      - ./secrets/constructicon_token:/run/secrets/constructicon_token:ro
    environment:
      - CONSTRUCTICON_BASE_URL=http://constructicon-web:8000
      - CONSTRUCTICON_DB_PATH=/app/data/imagerepo.db
      # #561 / #467 step 2: the same install token file as the web service. Required: with roles
      # enforced the MCP refuses to start without one. Clients send Authorization: Bearer <token>.
      - CONSTRUCTICON_INSTALL_TOKEN_FILE=/run/secrets/constructicon_token
    command: python -m mcp_server.server
    depends_on:
      - constructicon-web
    # #687: no `captions` network on purpose. The MCP never calls Ollama: its caption tools
    # queue work that web's worker runs (#549), so it has no reason to reach the model server.
    network_mode: bridge

  # Test instance: isolated DB/storage for testing schema changes, migration
  # scripts, etc. before touching production. #688: its code mounts live in
  # docker-compose.override.yml.example (the fast "copy in, restart" loop).
  constructicon-test:
    image: constructicon:latest
    container_name: constructicon-test
    ports:
      - "8001:8000"
      - "8101:8100"
    networks:
      - default
      - captions           # #687: shares the one `ollama` above (one GPU, one Ollama)
    volumes:
      - ./storage-test:/app/storage
      - ./db-test:/app/data
    environment:
      - IMAGEREPO_BASE_URL=http://10.0.1.78:8001
      - CONSTRUCTICON_DB_PATH=/app/data/imagerepo.db
      - CAPTION_OLLAMA_URL=http://ollama:11434
      - CAPTION_OLLAMA_MODEL=${CAPTION_OLLAMA_MODEL:-moondream}
    command: uvicorn web.app:app --host 0.0.0.0 --port 8000 --no-proxy-headers

  # #646: an HTTPS front door for an internet-facing install (NOT the home install, which stays
  # plain HTTP with no proxy). Caddy terminates TLS and forwards to the web service over the
  # `edge` network, whose fixed subnet gives the proxy a fixed address to trust. To use it:
  # uncomment this service and the `edge` network, add `edge` to constructicon-web's networks,
  # REMOVE constructicon-web's `ports:` (so nothing reaches the app except through the proxy), and
  # set CONSTRUCTICON_TRUSTED_PROXIES=172.30.0.10 (and CONSTRUCTICON_HSTS_SECONDS) on it.
  # ./Caddyfile:
  #   constructicon.example.com {
  #       request_body {
  #           max_size 30MB          # a second body cap in front of #649's
  #       }
  #       reverse_proxy constructicon-web:8000
  #   }
  # Caddy keeps the original Host header and sets X-Forwarded-For / X-Forwarded-Proto itself
  # (replacing any a client sent), which is exactly what the app reads.
  # proxy:
  #   image: caddy:2
  #   container_name: constructicon-proxy
  #   ports:
  #     - "80:80"
  #     - "443:443"
  #   volumes:
  #     - ./Caddyfile:/etc/caddy/Caddyfile:ro
  #     - ./caddy-data:/data
  #   networks:
  #     edge:
  #       ipv4_address: 172.30.0.10
  #   restart: unless-stopped

networks:
  # #646: the proxy's network (see the commented `proxy` service).
  # edge:
  #   ipam:
  #     config:
  #       - subnet: 172.30.0.0/24
  # #643: the restart sidecar's network. `internal: true` = no route out, no published
  # port; only services listed on it (constructicon-web, ollama-restarter) can reach it.
  restart-valve:
    internal: true
  # #687: app <-> Ollama. Internal like restart-valve: no route out, nothing published, only
  # the services listed on it (constructicon-web, constructicon-test, ollama) can reach it.
  captions:
    internal: true
  # #687: Ollama's own way out, used only to pull a model (registry.ollama.ai). Nothing else
  # joins it and nothing is published on it. An install that never pulls again (model already
  # on the volume) can drop it from the ollama service.
  ollama-egress: {}
