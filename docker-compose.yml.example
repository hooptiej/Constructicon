version: "3.8"

services:
  # #453: mount the DB's DIRECTORY, never the bare imagerepo.db file. SQLite runs in
  # WAL mode, which keeps -wal/-shm next to the DB; with a file-only mount each
  # container gets private copies and web + mcp corrupt the shared database.
  constructicon-web:
    build: .
    container_name: constructicon-web
    ports:
      - "8000:8000"
    volumes:
      - ./core:/app/core
      - ./web:/app/web
      - ./mcp_server:/app/mcp_server
      - ./assets:/app/assets:ro
      - ./storage:/app/storage
      - ./db:/app/data
      # #467 step 2: the install token, ONE file shared with the MCP service below. Create it with
      #   python3 scripts/mcp_token.py generate ./secrets/constructicon_token   (mode 600)
      - ./secrets/constructicon_token:/run/secrets/constructicon_token:ro
    environment:
      - IMAGEREPO_BASE_URL=http://10.0.1.78:8000
      - CONSTRUCTICON_DB_PATH=/app/data/imagerepo.db
      # Non-browser clients (scripts, the desktop uploader) send it as Authorization: Bearer.
      - CONSTRUCTICON_INSTALL_TOKEN_FILE=/run/secrets/constructicon_token
    command: uvicorn web.app:app --host 0.0.0.0 --port 8000

  constructicon-mcp:
    build: .
    container_name: constructicon-mcp
    volumes:
      - ./core:/app/core
      - ./web:/app/web
      - ./mcp_server:/app/mcp_server
      - ./assets:/app/assets:ro
      - ./storage:/app/storage
      - ./db:/app/data
      - ./secrets/constructicon_token:/run/secrets/constructicon_token:ro
    environment:
      - CONSTRUCTICON_BASE_URL=http://constructicon-web:8000
      - CONSTRUCTICON_DB_PATH=/app/data/imagerepo.db
      # #561 / #467 step 2: the same install token file as the web service. Required: with roles
      # enforced the MCP refuses to start without one. Clients send Authorization: Bearer <token>.
      - CONSTRUCTICON_INSTALL_TOKEN_FILE=/run/secrets/constructicon_token
    command: python -m mcp_server.server
    depends_on:
      - constructicon-web
    network_mode: bridge

  # Test instance: isolated DB/storage for testing schema changes, migration
  # scripts, etc. before touching production
  constructicon-test:
    build: .
    container_name: constructicon-test
    ports:
      - "8001:8000"
      - "8101:8100"
    volumes:
      - ./core:/app/core
      - ./web:/app/web
      - ./mcp_server:/app/mcp_server
      - ./assets:/app/assets:ro
      - ./storage-test:/app/storage
      - ./db-test:/app/data
    environment:
      - IMAGEREPO_BASE_URL=http://10.0.1.78:8001
      - CONSTRUCTICON_DB_PATH=/app/data/imagerepo.db
    command: uvicorn web.app:app --host 0.0.0.0 --port 8000
